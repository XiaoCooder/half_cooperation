---
import Layout from '../../layouts/Layout.astro';
import { posts, getPostBySlug, getPrevPost, getNextPost } from '../../data/posts';
import { marked } from 'marked';
import fs from 'node:fs/promises';
import path from 'node:path';

// 获取所有静态路径
export function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

// 获取当前文章的 slug
const { slug } = Astro.params;
const post = getPostBySlug(slug!);

// 文章不存在时 404
if (!post) {
  return Astro.redirect('/');
}

// 读取 Markdown 文件内容
const mdPath = path.join(process.cwd(), 'public', 'posts', `${post.slug}.md`);
const mdText = await fs.readFile(mdPath, 'utf-8');

// 解析 frontmatter 并分离正文
function parseMarkdownWithFrontmatter(content: string): { frontmatter: Record<string, any>; body: string } {
  const frontmatterRegex = /^---\s*\n([\s\S]*?)\n---\s*\n?([\s\S]*)$/;
  const match = content.match(frontmatterRegex);

  if (!match) {
    return { frontmatter: {}, body: content };
  }

  const frontmatterStr = match[1];
  const body = match[2];
  const frontmatter: Record<string, any> = {};

  // 简单解析 YAML frontmatter
  for (const line of frontmatterStr.split('\n')) {
    const colonIndex = line.indexOf(':');
    if (colonIndex === -1) continue;
    const key = line.slice(0, colonIndex).trim();
    let value = line.slice(colonIndex + 1).trim();

    // 处理数组格式 [a, b, c]
    if (value.startsWith('[') && value.endsWith(']')) {
      value = value
        .slice(1, -1)
        .split(',')
        .map((s: string) => s.trim().replace(/^['"]|['"]$/g, ''));
    }
    // 处理引号字符串
    else if ((value.startsWith("'") && value.endsWith("'")) || (value.startsWith('"') && value.endsWith('"'))) {
      value = value.slice(1, -1);
    }

    frontmatter[key] = value;
  }

  return { frontmatter, body };
}

const { body: markdownBody } = parseMarkdownWithFrontmatter(mdText);

// 配置 marked.js 选项
marked.setOptions({
  gfm: true,
  breaks: true,
});

// 渲染 Markdown 为 HTML
const renderedContent = marked.parse(markdownBody) as string;

// 获取上一篇/下一篇文章
const prevPost = getPrevPost(post.slug);
const nextPost = getNextPost(post.slug);

// SEO 描述
const seoDescription = post.excerpt || `${post.title} - SciFi Blog`;
---

<Layout title={`${post.title} | SciFi Blog`} description={seoDescription}>
  <div class="container mx-auto px-4 py-12 max-w-4xl">
    <!-- 面包屑导航 -->
    <nav class="flex items-center gap-2 mb-8 text-sm font-mono">
      <a href="/" class="text-scifi-muted hover:text-scifi-primary transition-colors">
        首页
      </a>
      <span class="text-scifi-border">/</span>
      <span class="text-scifi-text truncate">{post.title}</span>
    </nav>

    <!-- 返回按钮 -->
    <a href="/" class="inline-flex items-center gap-2 text-scifi-muted hover:text-scifi-primary transition-colors font-mono mb-8 group">
      <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      返回文章列表
    </a>

    <!-- 文章头部 -->
    <header class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="px-2 py-1 text-xs font-mono rounded bg-scifi-primary/10 text-scifi-primary border border-scifi-primary/20">
          {post.slug.toUpperCase()}
        </span>
        <span class="w-1 h-1 rounded-full bg-scifi-border"></span>
        <span class="text-xs font-mono text-scifi-muted">{post.date}</span>
      </div>

      <h1 class="text-3xl md:text-5xl font-bold mb-6 bg-gradient-to-r from-scifi-primary via-scifi-secondary to-scifi-accent bg-clip-text text-transparent">
        {post.title}
      </h1>

      {post.excerpt && (
        <p class="text-scifi-muted text-lg mb-6">{post.excerpt}</p>
      )}

      <!-- 标签 -->
      <div class="flex flex-wrap gap-2">
        {post.tags.map((tag) => (
          <span class="px-3 py-1 text-xs font-mono rounded-full bg-scifi-secondary/10 text-scifi-secondary border border-scifi-secondary/20">
            #{tag}
          </span>
        ))}
      </div>

      <!-- 标题下装饰线 -->
      <div class="mt-8 h-px bg-gradient-to-r from-scifi-primary/50 via-scifi-secondary/50 to-transparent"></div>
    </header>

    <!-- 文章内容 - Markdown 渲染 -->
    <article
      class="post-content bg-scifi-card border border-scifi-border rounded-xl p-6 md:p-10"
      set:html={renderedContent}
    />

    <!-- 文章底部装饰线 -->
    <div class="mt-10 h-px bg-gradient-to-r from-transparent via-scifi-border to-transparent"></div>

    <!-- 上一篇/下一篇导航 -->
    <nav class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- 上一篇 -->
      {prevPost ? (
        <a
          href={`/posts/${prevPost.slug}`}
          class="group block p-6 bg-scifi-card border border-scifi-border rounded-xl hover:border-scifi-primary/50 transition-all"
        >
          <div class="flex items-center gap-2 text-xs font-mono text-scifi-muted mb-3">
            <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            上一篇
          </div>
          <h3 class="text-lg font-semibold text-scifi-text group-hover:text-scifi-primary transition-colors mb-2 line-clamp-1">
            {prevPost.title}
          </h3>
          <p class="text-sm text-scifi-muted line-clamp-2">{prevPost.excerpt}</p>
          <div class="mt-3 text-xs font-mono text-scifi-muted/60">{prevPost.date}</div>
        </a>
      ) : (
        <div class="p-6 bg-scifi-card/50 border border-scifi-border/30 rounded-xl flex items-center justify-center">
          <span class="text-sm font-mono text-scifi-border">// 已是第一篇</span>
        </div>
      )}

      <!-- 下一篇 -->
      {nextPost ? (
        <a
          href={`/posts/${nextPost.slug}`}
          class="group block p-6 bg-scifi-card border border-scifi-border rounded-xl hover:border-scifi-primary/50 transition-all text-right"
        >
          <div class="flex items-center justify-end gap-2 text-xs font-mono text-scifi-muted mb-3">
            下一篇
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-scifi-text group-hover:text-scifi-primary transition-colors mb-2 line-clamp-1">
            {nextPost.title}
          </h3>
          <p class="text-sm text-scifi-muted line-clamp-2">{nextPost.excerpt}</p>
          <div class="mt-3 text-xs font-mono text-scifi-muted/60">{nextPost.date}</div>
        </a>
      ) : (
        <div class="p-6 bg-scifi-card/50 border border-scifi-border/30 rounded-xl flex items-center justify-center">
          <span class="text-sm font-mono text-scifi-border">// 已是最后一篇</span>
        </div>
      )}
    </nav>
  </div>
</Layout>

<!-- 文章详情页专用样式 -->
<style is:global>
  /* Markdown 渲染样式 */
  .post-content {
    line-height: 1.8;
  }

  .post-content h1 {
    font-size: 1.875rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: #e0e0e0;
  }

  .post-content h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    color: #e0e0e0;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(31, 41, 55, 0.5);
  }

  .post-content h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: #e0e0e0;
  }

  .post-content h2::before {
    content: '// ';
    color: #00d4ff;
    font-family: 'JetBrains Mono', monospace;
  }

  .post-content p {
    margin-bottom: 1.25rem;
    color: #e0e0e0;
  }

  .post-content a {
    color: #00d4ff;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s;
  }

  .post-content a:hover {
    color: #7000ff;
  }

  .post-content ul,
  .post-content ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
    color: #e0e0e0;
  }

  .post-content li {
    margin-bottom: 0.5rem;
  }

  .post-content ul > li::marker {
    color: #00d4ff;
  }

  .post-content ol > li::marker {
    color: #7000ff;
  }

  .post-content strong {
    color: #00d4ff;
    font-weight: 600;
  }

  .post-content em {
    color: #c0c0c0;
    font-style: italic;
  }

  /* 代码块样式 */
  .post-content code {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.875em;
    padding: 0.2em 0.4em;
    background: rgba(0, 212, 255, 0.1);
    border-radius: 0.25rem;
    color: #00d4ff;
  }

  .post-content pre {
    margin-bottom: 1.5rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(31, 41, 55, 0.8);
    overflow: hidden;
    background: #1e1e2e !important;
  }

  .post-content pre code {
    display: block;
    padding: 1.25rem;
    background: transparent;
    color: #cdd6f4;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  /* 引用块样式 */
  .post-content blockquote {
    border-left: 3px solid #7000ff;
    padding: 0.75rem 1rem;
    margin: 1.25rem 0;
    background: rgba(112, 0, 255, 0.05);
    border-radius: 0 0.5rem 0.5rem 0;
    color: #b0b0b0;
  }

  .post-content blockquote p:last-child {
    margin-bottom: 0;
  }

  /* 表格样式 */
  .post-content table {
    width: 100%;
    margin-bottom: 1.25rem;
    border-collapse: collapse;
  }

  .post-content th,
  .post-content td {
    padding: 0.75rem;
    border: 1px solid rgba(31, 41, 55, 0.8);
    text-align: left;
  }

  .post-content th {
    background: rgba(0, 212, 255, 0.05);
    color: #00d4ff;
    font-weight: 600;
  }

  .post-content td {
    color: #e0e0e0;
  }

  /* 水平线 */
  .post-content hr {
    border: none;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(0, 212, 255, 0.3), transparent);
    margin: 2rem 0;
  }

  /* 响应式调整 */
  @media (max-width: 768px) {
    .post-content {
      padding: 1rem !important;
    }

    .post-content pre code {
      padding: 1rem;
      font-size: 0.8rem;
    }
  }
</style>
