        "createAdminPost(input)",
        "updateAdminPost(postId, input)",
        "deleteAdminPost(postId)",
        "requireAdminAuth()"
      ]
    }
  ],
  "features": [
    "认证守卫 - 未登录自动跳转 /login",
    "文章列表表格 - 标题/状态/分类/浏览量/创建时间",
    "统计卡片 - 总文章数/已发布/草稿",
    "分页控件",
    "行内操作 - 编辑跳转 / 确认删除",
    "用户名显示 / 登出按钮",
    "科幻风格 UI 主题（复用 Layout 样式）"
  ],
  "integration": {
    "task_005": {
