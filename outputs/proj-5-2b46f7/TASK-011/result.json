    "task_006": {
      "api_endpoints": [
        "POST /api/posts",
        "PUT /api/posts/{id}",
        "DELETE /api/posts/{id}"
      ],
      "usage": "创建/更新/删除文章"
    },
    "task_009": {
      "frontend_base": "Astro + Tailwind CSS",
      "style_system": "科幻风格主题（复用 global.css 样式类）"
    },
    "task_010": {
      "modules": [
        "auth.ts - authFetch() 自动携带 Bearer token",
