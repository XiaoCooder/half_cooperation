---
/**
 * 登录页面
 * 任务码: TASK-010
 * 实现用户名密码表单，调用后端登录 API
 */

import Layout from '../layouts/Layout.astro';

// 页面标题和描述
const pageTitle = '登录 - SciFi Blog';
const pageDescription = '登录到科幻风格个人博客系统';
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="min-h-[80vh] flex items-center justify-center px-4 py-12 hero-glow">
    <div class="w-full max-w-md">
      <!-- 登录卡片 -->
      <div class="bg-scifi-card/80 backdrop-blur-md rounded-xl border border-scifi-border/50 p-8 relative">
        <!-- 顶部装饰线 -->
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-scifi-primary via-scifi-secondary to-scifi-accent rounded-t-xl"></div>

        <!-- 标题 -->
        <div class="text-center mb-8">
          <div class="inline-flex items-center gap-2 mb-4">
            <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-scifi-primary to-scifi-secondary flex items-center justify-center pulse-glow">
              <span class="text-white font-mono font-bold">&gt;_</span>
            </div>
          </div>
          <h1 class="text-2xl font-bold text-scifi-text font-mono">
            <span class="text-scifi-primary">&gt;</span> 系统登录
          </h1>
          <p class="text-scifi-muted text-sm mt-2 font-mono">
            // 请输入您的认证凭证
          </p>
        </div>

        <!-- 登录表单 -->
        <form id="loginForm" class="space-y-6">
          <!-- 用户名 -->
          <div class="space-y-2">
            <label for="username" class="block text-sm font-mono text-scifi-text">
              <span class="text-scifi-secondary">const</span> username <span class="text-scifi-muted">=</span>
            </label>
            <div class="relative">
              <input
                type="text"
                id="username"
                name="username"
                required
                minlength="3"
                maxlength="50"
                placeholder="请输入用户名"
                class="w-full px-4 py-3 bg-scifi-bg border border-scifi-border rounded-lg text-scifi-text font-mono placeholder:text-scifi-muted/50 focus:outline-none focus:border-scifi-primary focus:ring-1 focus:ring-scifi-primary/50 transition-all"
              />
              <div class="absolute right-3 top-1/2 -translate-y-1/2 text-scifi-muted">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
            </div>
          </div>

          <!-- 密码 -->
          <div class="space-y-2">
            <label for="password" class="block text-sm font-mono text-scifi-text">
              <span class="text-scifi-secondary">const</span> password <span class="text-scifi-muted">=</span>
            </label>
            <div class="relative">
              <input
                type="password"
                id="password"
                name="password"
                required
                minlength="6"
                maxlength="100"
                placeholder="请输入密码"
                class="w-full px-4 py-3 bg-scifi-bg border border-scifi-border rounded-lg text-scifi-text font-mono placeholder:text-scifi-muted/50 focus:outline-none focus:border-scifi-primary focus:ring-1 focus:ring-scifi-primary/50 transition-all"
              />
              <button
                type="button"
                id="togglePassword"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-scifi-muted hover:text-scifi-primary transition-colors"
              >
                <svg id="eyeIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <svg id="eyeOffIcon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                </svg>
              </button>
            </div>
          </div>

          <!-- 记住登录状态 -->
          <div class="flex items-center gap-2">
            <input
              type="checkbox"
              id="remember"
              name="remember"
              class="w-4 h-4 rounded border-scifi-border bg-scifi-bg text-scifi-primary focus:ring-scifi-primary/50 focus:ring-offset-0"
            />
            <label for="remember" class="text-sm text-scifi-muted font-mono">
              <span class="text-scifi-secondary">const</span> remember <span class="text-scifi-muted">=</span> <span class="text-neon-green">true</span>
            </label>
          </div>

          <!-- 错误提示 -->
          <div id="errorMessage" class="hidden p-4 bg-red-500/10 border border-red-500/30 rounded-lg">
            <p class="text-red-400 text-sm font-mono flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span id="errorText"></span>
            </p>
          </div>

          <!-- 登录按钮 -->
          <button
            type="submit"
            id="loginButton"
            class="w-full py-3 px-4 bg-gradient-to-r from-scifi-primary to-scifi-secondary text-white font-mono font-semibold rounded-lg hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-scifi-primary/50 transition-all relative overflow-hidden group disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <span class="relative z-10 flex items-center justify-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
              </svg>
              <span id="buttonText">执行登录</span>
            </span>
            <!-- 加载状态 -->
            <span id="loadingSpinner" class="hidden absolute inset-0 flex items-center justify-center">
              <svg class="w-6 h-6 animate-spin" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </span>
          </button>
        </form>

        <!-- 分割线 -->
        <div class="my-6 flex items-center gap-4">
          <div class="flex-1 h-px bg-gradient-to-r from-transparent via-scifi-border to-transparent"></div>
          <span class="text-scifi-muted text-xs font-mono">// or</span>
          <div class="flex-1 h-px bg-gradient-to-r from-transparent via-scifi-border to-transparent"></div>
        </div>

        <!-- 注册链接 -->
        <div class="text-center">
          <p class="text-scifi-muted text-sm font-mono">
            <span class="text-scifi-muted">// 尚未注册？</span>
            <a href="/register" class="text-scifi-primary hover:text-scifi-secondary transition-colors ml-2">
              创建账户 <span class="text-scifi-accent">&gt;</span>
            </a>
          </p>
        </div>

        <!-- 底部装饰 -->
        <div class="mt-8 pt-4 border-t border-scifi-border/30">
          <p class="text-center text-scifi-muted text-xs font-mono">
            <span class="text-neon-green">●</span> 安全连接已启用 | AES-256 加密
          </p>
        </div>
      </div>

      <!-- 返回首页链接 -->
      <div class="mt-6 text-center">
        <a href="/" class="inline-flex items-center gap-2 text-scifi-muted hover:text-scifi-primary transition-colors font-mono text-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          返回首页
        </a>
      </div>
    </div>
  </div>
</Layout>

<!-- 登录表单客户端脚本 -->
<script>
  import { login, saveUserInfo, isAuthenticated } from '../auth';

  // 表单元素
  const form = document.getElementById('loginForm') as HTMLFormElement;
  const usernameInput = document.getElementById('username') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const loginButton = document.getElementById('loginButton') as HTMLButtonElement;
  const buttonText = document.getElementById('buttonText');
  const loadingSpinner = document.getElementById('loadingSpinner');
  const errorMessage = document.getElementById('errorMessage');
  const errorText = document.getElementById('errorText');
  const togglePassword = document.getElementById('togglePassword');
  const eyeIcon = document.getElementById('eyeIcon');
  const eyeOffIcon = document.getElementById('eyeOffIcon');

  // 密码显示/隐藏切换
  togglePassword?.addEventListener('click', () => {
    const isPassword = passwordInput.type === 'password';
    passwordInput.type = isPassword ? 'text' : 'password';
    eyeIcon?.classList.toggle('hidden', !isPassword);
    eyeOffIcon?.classList.toggle('hidden', isPassword);
  });

  // 显示错误消息
  function showError(message: string) {
    if (errorText) errorText.textContent = message;
    errorMessage?.classList.remove('hidden');
  }

  // 隐藏错误消息
  function hideError() {
    errorMessage?.classList.add('hidden');
  }

  // 设置加载状态
  function setLoading(isLoading: boolean) {
    if (loginButton) loginButton.disabled = isLoading;
    if (buttonText) buttonText.textContent = isLoading ? '登录中...' : '执行登录';
    loadingSpinner?.classList.toggle('hidden', !isLoading);
  }

  // 检查是否已登录
  if (isAuthenticated()) {
    // 已登录则跳转到首页或用户中心
    window.location.href = '/';
  }

  // 表单提交处理
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideError();
    setLoading(true);

    const username = usernameInput.value.trim();
    const password = passwordInput.value;

    try {
      // 调用登录 API
      const tokenResponse = await login({ username, password });

      // 登录成功，跳转到首页
      console.log('登录成功:', tokenResponse);

      // 显示成功提示
      if (buttonText) buttonText.textContent = '登录成功!';

      // 短暂延迟后跳转
      setTimeout(() => {
        // 获取用户信息
        import('../auth').then(auth => {
          auth.getCurrentUser().then(user => {
            if (user) {
              saveUserInfo(user);
            }
            // 跳转到首页或用户中心
            window.location.href = '/';
          });
        });
      }, 500);

    } catch (error) {
      setLoading(false);
      const errorMsg = error instanceof Error ? error.message : '登录失败，请稍后重试';
      showError(errorMsg);

      // 添加输入框错误样式
      usernameInput.classList.add('border-red-500/50');
      passwordInput.classList.add('border-red-500/50');

      // 3秒后移除错误样式
      setTimeout(() => {
        usernameInput.classList.remove('border-red-500/50');
        passwordInput.classList.remove('border-red-500/50');
      }, 3000);
    }
  });

  // 输入时清除错误样式
  usernameInput?.addEventListener('input', () => {
    usernameInput.classList.remove('border-red-500/50');
    hideError();
  });

  passwordInput?.addEventListener('input', () => {
    passwordInput.classList.remove('border-red-500/50');
    hideError();
  });
</script>

<style>
  /* 登录页面额外样式 */
  .pulse-glow {
    animation: pulse-glow 2s ease-in-out infinite;
  }

  /* 输入框聚焦发光效果 */
  input:focus {
    box-shadow: 0 0 10px rgba(0, 212, 255, 0.3);
  }

  /* 按钮悬浮效果 */
  #loginButton:not(:disabled):hover {
    box-shadow: 0 0 20px rgba(0, 212, 255, 0.4), 0 0 40px rgba(112, 0, 255, 0.2);
  }

  /* 加载动画 */
  .animate-spin {
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
</style>