---
import Layout from '../layouts/Layout.astro';
import { posts as localPosts } from '../data/posts';

// API 配置
const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL || 'http://localhost:5000/api';

// 从后端 API 获取文章列表
async function fetchPostsFromAPI(): Promise<typeof localPosts> {
  try {
    // 在构建时使用完整 URL
    const apiUrl = import.meta.env.DEV
      ? '/api/posts'
      : `${API_BASE_URL}/posts`;

    const response = await fetch(apiUrl, {
      // 添加超时控制
      signal: AbortSignal.timeout(5000),
    });

    if (!response.ok) {
      throw new Error(`Failed to fetch posts: ${response.status}`);
    }

    const data = await response.json();

    // 处理分页响应或数组响应
    const posts = data.items || data || [];

    // 按日期倒序排序
    return posts.sort((a: any, b: any) =>
      new Date(b.date).getTime() - new Date(a.date).getTime()
    );
  } catch (error) {
    console.warn('API unavailable, using local data:', error);
    return localPosts;
  }
}

// 获取文章列表
const posts = await fetchPostsFromAPI();
---

<Layout title="SciFi Blog | 科幻风格个人博客">
  <!-- Hero 区域 - 背景光效 -->
  <section class="hero-glow relative py-24 md:py-32 overflow-hidden">
    <div class="container mx-auto px-4 max-w-5xl text-center">
      <!-- 装饰元素 -->
      <div class="absolute top-8 left-1/4 w-2 h-2 rounded-full bg-scifi-primary animate-pulse opacity-60"></div>
      <div class="absolute top-16 right-1/3 w-1 h-1 rounded-full bg-scifi-secondary animate-pulse opacity-40"></div>
      <div class="absolute bottom-12 left-1/3 w-1.5 h-1.5 rounded-full bg-scifi-accent animate-pulse opacity-50"></div>

      <!-- 主标题 -->
      <h1 class="text-5xl md:text-7xl font-bold mb-6 relative">
        <span class="bg-gradient-to-r from-scifi-primary via-scifi-secondary to-scifi-accent bg-clip-text text-transparent">
          SciFi Blog
        </span>
        <!-- 标题下方装饰线 -->
        <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 w-32 md:w-48 h-1 bg-gradient-to-r from-scifi-primary via-scifi-secondary to-scifi-accent rounded-full opacity-60"></div>
      </h1>

      <!-- 副标题 -->
      <p class="text-scifi-muted text-lg md:text-xl font-mono mt-4 mb-2">
        <span class="text-scifi-primary">&lt;</span>
        探索代码与想象的边界
        <span class="text-scifi-accent">/&gt;</span>
      </p>

      <!-- 状态指示 -->
      <div class="inline-flex items-center gap-3 px-4 py-2 mt-6 rounded-full bg-scifi-card/50 border border-scifi-border/30 backdrop-blur-sm">
        <span class="w-2 h-2 rounded-full bg-neon-green animate-pulse"></span>
        <span class="text-xs font-mono text-scifi-muted">API_CONNECTED</span>
        <span class="text-xs font-mono text-scifi-primary">v1.0.0</span>
      </div>

      <!-- CTA 按钮 -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-10">
        <a href="#articles" class="neon-button rounded-lg">
          探索文章
        </a>
        <a
          href="/chat"
          class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-scifi-secondary/20 to-scifi-accent/20 rounded-lg border border-scifi-secondary/30 text-scifi-secondary hover:bg-scifi-secondary/30 hover:border-scifi-secondary transition-all font-mono"
        >
          <span class="animate-pulse">&gt;_</span>
          AI对话
        </a>
      </div>
    </div>

    <!-- Hero 底部装饰 -->
    <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-scifi-primary/50 to-transparent"></div>
  </section>

  <!-- 文章列表区域 -->
  <section id="articles" class="container mx-auto px-4 py-16 max-w-5xl">
    <!-- 区域标题 -->
    <div class="flex items-center gap-4 mb-10">
      <h2 class="text-2xl md:text-3xl font-semibold text-scifi-primary font-mono">
        // 最新文章
      </h2>
      <div class="flex-1 h-px bg-gradient-to-r from-scifi-primary/30 to-transparent"></div>
      <span class="text-sm font-mono text-scifi-muted">{posts.length}篇</span>
    </div>

    <!-- 文章卡片网格 -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {posts.map((post, index) => (
        <article class="card-hover bg-scifi-card border border-scifi-border rounded-xl p-6 group">
          <a href={`/posts/${post.slug}`} class="block">
            <!-- 卡片序号 -->
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-xs text-scifi-muted">
                ARTICLE_{index.toString().padStart(2, '0')}
              </span>
              <div class="w-8 h-8 rounded-lg bg-scifi-bg border border-scifi-border flex items-center justify-center group-hover:border-scifi-primary group-hover:bg-scifi-primary/10 transition-all">
                <svg class="w-4 h-4 text-scifi-muted group-hover:text-scifi-primary transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </div>
            </div>

            <!-- 文章标题 -->
            <h3 class="text-xl font-semibold mb-3 text-scifi-text group-hover:text-scifi-primary transition-colors">
              {post.title}
            </h3>

            <!-- 文章摘要 -->
            {post.excerpt && (
              <p class="text-scifi-muted text-sm mb-4 line-clamp-2">
                {post.excerpt}
              </p>
            )}

            <!-- 元信息 -->
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono text-scifi-muted/70">
                <svg class="w-3 h-3 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                {post.date}
              </span>

              <!-- 标签 -->
              <div class="flex gap-2">
                {post.tags?.slice(0, 2).map(tag => (
                  <span class="px-2 py-1 text-xs font-mono rounded bg-scifi-secondary/10 text-scifi-secondary border border-scifi-secondary/20">
                    #{tag}
                  </span>
                ))}
              </div>
            </div>
          </a>

          <!-- 卡片底部渐变线 -->
          <div class="mt-4 pt-4 border-t border-scifi-border/30">
            <div class="h-0.5 bg-gradient-to-r from-transparent via-scifi-primary/20 to-transparent group-hover:via-scifi-primary/40 transition-all"></div>
          </div>
        </article>
      ))}
    </div>

    <!-- 更多文章提示 -->
    {posts.length === 0 && (
      <div class="text-center py-12">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-scifi-card border border-scifi-border">
          <span class="w-2 h-2 rounded-full bg-scifi-muted animate-pulse"></span>
          <span class="font-mono text-sm text-scifi-muted">暂无文章，等待初始化...</span>
        </div>
      </div>
    )}
  </section>

  <!-- 特色区域 -->
  <section class="container mx-auto px-4 py-16 max-w-5xl">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- 特色卡片 1 -->
      <div class="gradient-border p-6 rounded-xl bg-scifi-card">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-lg bg-scifi-primary/20 flex items-center justify-center">
            <svg class="w-5 h-5 text-scifi-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
            </svg>
          </div>
          <h3 class="font-mono text-sm text-scifi-primary">// 代码高亮</h3>
        </div>
        <p class="text-sm text-scifi-muted">
          支持 Markdown 与代码块语法高亮，让技术文章更加易读
        </p>
      </div>

      <!-- 特色卡片 2 -->
      <div class="gradient-border p-6 rounded-xl bg-scifi-card">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-lg bg-scifi-secondary/20 flex items-center justify-center">
            <svg class="w-5 h-5 text-scifi-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.949-3.745A9.863 9.863 0 013 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
            </svg>
          </div>
          <h3 class="font-mono text-sm text-scifi-secondary">// AI对话</h3>
        </div>
        <p class="text-sm text-scifi-muted">
          内置 Claude AI 助手，智能问答与创意探索
        </p>
      </div>

      <!-- 特色卡片 3 -->
      <div class="gradient-border p-6 rounded-xl bg-scifi-card">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-lg bg-scifi-accent/20 flex items-center justify-center">
            <svg class="w-5 h-5 text-scifi-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="font-mono text-sm text-scifi-accent">// API驱动</h3>
        </div>
        <p class="text-sm text-scifi-muted">
          前后端分离架构，通过 RESTful API 动态获取数据
        </p>
      </div>
    </div>
  </section>

  <!-- AI 对话入口 CTA -->
  <section class="container mx-auto px-4 py-12 max-w-5xl">
    <div class="relative rounded-2xl overflow-hidden">
      <!-- 背景光效 -->
      <div class="absolute inset-0 bg-gradient-to-r from-scifi-secondary/10 via-scifi-accent/10 to-scifi-primary/10"></div>
      <div class="absolute inset-0 bg-scifi-card/80 backdrop-blur-sm"></div>

      <!-- 内容 -->
      <div class="relative p-8 md:p-12 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-scifi-secondary/20 border border-scifi-secondary/30 mb-6">
          <span class="w-2 h-2 rounded-full bg-scifi-secondary animate-pulse"></span>
          <span class="text-xs font-mono text-scifi-secondary">AI_READY</span>
        </div>

        <h2 class="text-2xl md:text-3xl font-bold mb-4">
          <span class="text-scifi-text">准备好开始</span>
          <span class="text-scifi-primary">探索</span>
          <span class="text-scifi-text">了吗？</span>
        </h2>

        <p class="text-scifi-muted mb-8 max-w-md mx-auto">
          与 AI 助手对话，解锁无限创意与可能性
        </p>

        <a
          href="/chat"
          class="inline-flex items-center gap-3 px-8 py-4 bg-gradient-to-r from-scifi-secondary to-scifi-accent rounded-xl text-white font-semibold hover:opacity-90 transition-all pulse-glow group"
        >
          <span class="font-mono text-lg">&gt;_</span>
          <span>启动 AI 对话</span>
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>

        <!-- 键盘快捷键提示 -->
        <p class="text-xs text-scifi-muted/60 mt-4 font-mono">
          按 <kbd class="px-2 py-1 rounded bg-scifi-bg border border-scifi-border text-scifi-muted">Enter</kbd> 快速启动
        </p>
      </div>

      <!-- 装饰边框 -->
      <div class="absolute inset-0 rounded-2xl border border-scifi-border/50"></div>
    </div>
  </section>
</Layout>
