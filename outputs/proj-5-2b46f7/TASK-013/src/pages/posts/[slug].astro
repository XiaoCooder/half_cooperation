---
import Layout from '../../layouts/Layout.astro';
import { posts as localPosts, getPostBySlug as getLocalPostBySlug } from '../../data/posts';
import { marked } from 'marked';

// API 配置
const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL || 'http://localhost:5000/api';

// 从后端 API 获取单篇文章详情
async function fetchPostFromAPI(slug: string): Promise<typeof localPosts[0] | null> {
  try {
    // 在构建时使用完整 URL
    const apiUrl = import.meta.env.DEV
      ? `/api/posts/${slug}`
      : `${API_BASE_URL}/posts/${slug}`;

    const response = await fetch(apiUrl, {
      signal: AbortSignal.timeout(5000),
    });

    if (!response.ok) {
      throw new Error(`Failed to fetch post: ${response.status}`);
    }

    const post = await response.json();
    return post;
  } catch (error) {
    console.warn(`API unavailable for ${slug}, using local data:`, error);
    return getLocalPostBySlug(slug) || null;
  }
}

// 从后端 API 获取所有文章列表（用于获取上一篇/下一篇）
async function fetchPostsFromAPI(): Promise<typeof localPosts> {
  try {
    const apiUrl = import.meta.env.DEV
      ? '/api/posts'
      : `${API_BASE_URL}/posts`;

    const response = await fetch(apiUrl, {
      signal: AbortSignal.timeout(5000),
    });

    if (!response.ok) {
      throw new Error(`Failed to fetch posts: ${response.status}`);
    }

    const data = await response.json();
    const posts = data.items || data || [];

    return posts.sort((a: any, b: any) =>
      new Date(b.date).getTime() - new Date(a.date).getTime()
    );
  } catch (error) {
    console.warn('API unavailable, using local data:', error);
    return localPosts;
  }
}

// 获取上一篇文章
function getPrevPost(posts: typeof localPosts, currentSlug: string): typeof localPosts[0] | undefined {
  const currentIndex = posts.findIndex(p => p.slug === currentSlug);
  if (currentIndex < posts.length - 1) {
    return posts[currentIndex + 1];
  }
  return undefined;
}

// 获取下一篇文章
function getNextPost(posts: typeof localPosts, currentSlug: string): typeof localPosts[0] | undefined {
  const currentIndex = posts.findIndex(p => p.slug === currentSlug);
  if (currentIndex > 0) {
    return posts[currentIndex - 1];
  }
  return undefined;
}

// 获取当前文章的 slug
const { slug } = Astro.params;

// 获取文章详情
const post = await fetchPostFromAPI(slug!);

// 文章不存在时 404
if (!post) {
  return Astro.redirect('/');
}

// 获取所有文章用于导航
const allPosts = await fetchPostsFromAPI();

// 获取上一篇/下一篇文章
const prevPost = getPrevPost(allPosts, post.slug);
const nextPost = getNextPost(allPosts, post.slug);

// 配置 marked.js 选项
marked.setOptions({
  gfm: true,
  breaks: true,
});

// 渲染 Markdown 为 HTML（使用 API 返回的 content 或本地 Markdown）
const renderedContent = post.content
  ? (marked.parse(post.content) as string)
  : '';

// SEO 描述
const seoDescription = post.excerpt || `${post.title} - SciFi Blog`;
---

<Layout title={`${post.title} | SciFi Blog`} description={seoDescription}>
  <div class="container mx-auto px-4 py-12 max-w-4xl">
    <!-- 面包屑导航 -->
    <nav class="flex items-center gap-2 mb-8 text-sm font-mono">
      <a href="/" class="text-scifi-muted hover:text-scifi-primary transition-colors">
        首页
      </a>
      <span class="text-scifi-border">/</span>
      <span class="text-scifi-text truncate">{post.title}</span>
    </nav>

    <!-- 返回按钮 -->
    <a href="/" class="inline-flex items-center gap-2 text-scifi-muted hover:text-scifi-primary transition-colors font-mono mb-8 group">
      <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      返回文章列表
    </a>

    <!-- 文章头部 -->
    <header class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="px-2 py-1 text-xs font-mono rounded bg-scifi-primary/10 text-scifi-primary border border-scifi-primary/20">
          {post.slug.toUpperCase()}
        </span>
        <span class="w-1 h-1 rounded-full bg-scifi-border"></span>
        <span class="text-xs font-mono text-scifi-muted">{post.date}</span>
        {post.view_count !== undefined && (
          <span class="text-xs font-mono text-scifi-muted/70">
            <svg class="w-3 h-3 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
            </svg>
            {post.view_count} 次阅读
          </span>
        )}
      </div>

      <h1 class="text-3xl md:text-5xl font-bold mb-6 bg-gradient-to-r from-scifi-primary via-scifi-secondary to-scifi-accent bg-clip-text text-transparent">
        {post.title}
      </h1>

      {post.excerpt && (
        <p class="text-scifi-muted text-lg mb-6">{post.excerpt}</p>
      )}

      <!-- 标签 -->
      <div class="flex flex-wrap gap-2">
        {post.tags?.map((tag: string) => (
          <span class="px-3 py-1 text-xs font-mono rounded-full bg-scifi-secondary/10 text-scifi-secondary border border-scifi-secondary/20">
            #{tag}
          </span>
        ))}
      </div>

      <!-- 标题下装饰线 -->
      <div class="mt-8 h-px bg-gradient-to-r from-scifi-primary/50 via-scifi-secondary/50 to-transparent"></div>
    </header>

    <!-- 文章内容 - Markdown 渲染 -->
    {renderedContent && (
      <article
        class="post-content bg-scifi-card border border-scifi-border rounded-xl p-6 md:p-10"
        set:html={renderedContent}
      />
    )}

    <!-- 文章底部装饰线 -->
    <div class="mt-10 h-px bg-gradient-to-r from-transparent via-scifi-border to-transparent"></div>

    <!-- 上一篇/下一篇导航 -->
    <nav class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- 上一篇 -->
      {prevPost ? (
        <a
          href={`/posts/${prevPost.slug}`}
          class="group block p-6 bg-scifi-card border border-scifi-border rounded-xl hover:border-scifi-primary/50 transition-all"
        >
          <div class="flex items-center gap-2 text-xs font-mono text-scifi-muted mb-3">
            <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            上一篇
          </div>
          <h3 class="text-lg font-semibold text-scifi-text group-hover:text-scifi-primary transition-colors mb-2 line-clamp-1">
            {prevPost.title}
          </h3>
          <p class="text-sm text-scifi-muted line-clamp-2">{prevPost.excerpt}</p>
          <div class="mt-3 text-xs font-mono text-scifi-muted/60">{prevPost.date}</div>
        </a>
      ) : (
        <div class="p-6 bg-scifi-card/50 border border-scifi-border/30 rounded-xl flex items-center justify-center">
          <span class="text-sm font-mono text-scifi-border">// 已是第一篇</span>
        </div>
      )}

      <!-- 下一篇 -->
      {nextPost ? (
        <a
          href={`/posts/${nextPost.slug}`}
          class="group block p-6 bg-scifi-card border border-scifi-border rounded-xl hover:border-scifi-primary/50 transition-all text-right"
        >
          <div class="flex items-center justify-end gap-2 text-xs font-mono text-scifi-muted mb-3">
            下一篇
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-scifi-text group-hover:text-scifi-primary transition-colors mb-2 line-clamp-1">
            {nextPost.title}
          </h3>
          <p class="text-sm text-scifi-muted line-clamp-2">{nextPost.excerpt}</p>
          <div class="mt-3 text-xs font-mono text-scifi-muted/60">{nextPost.date}</div>
        </a>
      ) : (
        <div class="p-6 bg-scifi-card/50 border border-scifi-border/30 rounded-xl flex items-center justify-center">
          <span class="text-sm font-mono text-scifi-border">// 已是最后一篇</span>
        </div>
      )}
    </nav>
  </div>
</Layout>

<!-- 文章详情页专用样式 -->
<style is:global>
  /* Markdown 渲染样式 */
  .post-content {
    line-height: 1.8;
  }

  .post-content h1 {
    font-size: 1.875rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: #e0e0e0;
  }

  .post-content h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    color: #e0e0e0;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(31, 41, 55, 0.5);
  }

  .post-content h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: #e0e0e0;
  }

  .post-content h2::before {
    content: '// ';
    color: #00d4ff;
    font-family: 'JetBrains Mono', monospace;
  }

  .post-content p {
    margin-bottom: 1.25rem;
    color: #e0e0e0;
  }

  .post-content a {
    color: #00d4ff;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s;
  }

  .post-content a:hover {
    color: #7000ff;
  }

  .post-content ul,
  .post-content ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
    color: #e0e0e0;
  }

  .post-content li {
    margin-bottom: 0.5rem;
  }

  .post-content ul > li::marker {
    color: #00d4ff;
  }

  .post-content ol > li::marker {
    color: #7000ff;
  }

  .post-content strong {
    color: #00d4ff;
    font-weight: 600;
  }

  .post-content em {
    color: #c0c0c0;
    font-style: italic;
  }

  /* 代码块样式 */
  .post-content code {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.875em;
    padding: 0.2em 0.4em;
    background: rgba(0, 212, 255, 0.1);
    border-radius: 0.25rem;
    color: #00d4ff;
  }

  .post-content pre {
    margin-bottom: 1.5rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(31, 41, 55, 0.8);
    overflow: hidden;
    background: #1e1e2e !important;
  }

  .post-content pre code {
    display: block;
    padding: 1.25rem;
    background: transparent;
    color: #cdd6f4;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  /* 引用块样式 */
  .post-content blockquote {
    border-left: 3px solid #7000ff;
    padding: 0.75rem 1rem;
    margin: 1.25rem 0;
    background: rgba(112, 0, 255, 0.05);
    border-radius: 0 0.5rem 0.5rem 0;
    color: #b0b0b0;
  }

  .post-content blockquote p:last-child {
    margin-bottom: 0;
  }

  /* 表格样式 */
  .post-content table {
    width: 100%;
    margin-bottom: 1.25rem;
    border-collapse: collapse;
  }

  .post-content th,
  .post-content td {
    padding: 0.75rem;
    border: 1px solid rgba(31, 41, 55, 0.8);
    text-align: left;
  }

  .post-content th {
    background: rgba(0, 212, 255, 0.05);
    color: #00d4ff;
    font-weight: 600;
  }

  .post-content td {
    color: #e0e0e0;
  }

  /* 水平线 */
  .post-content hr {
    border: none;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(0, 212, 255, 0.3), transparent);
    margin: 2rem 0;
  }

  /* 响应式调整 */
  @media (max-width: 768px) {
    .post-content {
      padding: 1rem !important;
    }

    .post-content pre code {
      padding: 1rem;
      font-size: 0.8rem;
    }
  }
</style>
