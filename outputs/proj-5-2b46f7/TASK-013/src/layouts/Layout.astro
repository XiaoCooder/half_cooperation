---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '科幻风格个人博客 - 探索代码与想象的边界' } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- 字体 -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  <!-- highlight.js 样式 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css">

  <style is:global>
    /* 确保网格背景在最底层 */
    .grid-background {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: -100;
      overflow: hidden;
      pointer-events: none;
    }
  </style>
</head>
<body class="min-h-screen bg-scifi-bg text-scifi-text antialiased flex flex-col">
  <!-- 网格背景 -->
  <div class="grid-background"></div>

  <!-- 导航栏 -->
  <header class="sticky top-0 z-50 bg-scifi-bg/80 backdrop-blur-md border-b border-scifi-border/50">
    <nav class="container mx-auto px-4 py-4 max-w-5xl flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 group">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-scifi-primary to-scifi-secondary flex items-center justify-center pulse-glow">
          <span class="text-white font-mono font-bold text-sm">&gt;_</span>
        </div>
        <span class="font-semibold text-scifi-text group-hover:text-scifi-primary transition-colors">
          SciFi Blog
        </span>
      </a>

      <div class="flex items-center gap-6">
        <a href="/" class="font-mono text-sm text-scifi-muted hover:text-scifi-primary transition-colors">
          首页
        </a>
        <a href="/chat" class="font-mono text-sm px-4 py-2 rounded-lg border border-scifi-secondary/30 text-scifi-secondary hover:bg-scifi-secondary/10 hover:border-scifi-secondary transition-all">
          AI对话
        </a>
      </div>
    </nav>
  </header>

  <!-- 主内容区域 -->
  <main class="flex-1 relative z-10">
    <slot />
  </main>

  <!-- 页脚 -->
  <footer class="relative z-10 mt-auto border-t border-scifi-border/30 bg-scifi-card/50 backdrop-blur-sm">
    <div class="container mx-auto px-4 py-8 max-w-5xl">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Logo区域 -->
        <div class="flex flex-col gap-3">
          <div class="flex items-center gap-2">
            <div class="w-6 h-6 rounded bg-gradient-to-br from-scifi-primary to-scifi-secondary flex items-center justify-center">
              <span class="text-white font-mono font-bold text-xs">&gt;</span>
            </div>
            <span class="font-mono text-sm text-scifi-primary">SciFi Blog</span>
          </div>
          <p class="text-scifi-muted text-sm font-mono">
            探索代码与想象的边界
          </p>
          <div class="flex gap-3 mt-2">
            <a href="#" class="w-8 h-8 rounded-lg bg-scifi-card border border-scifi-border flex items-center justify-center hover:border-scifi-primary hover:text-scifi-primary transition-all">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.835 1.305 3.51.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.88-.015 3.255 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
            </a>
            <a href="#" class="w-8 h-8 rounded-lg bg-scifi-card border border-scifi-border flex items-center justify-center hover:border-scifi-secondary hover:text-scifi-secondary transition-all">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723 10.054 10.054 0 01-3.127 1.184 4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.161a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
            </a>
          </div>
        </div>

        <!-- 链接区域 -->
        <div class="flex flex-col gap-3">
          <h3 class="font-mono text-sm text-scifi-primary">// 快速链接</h3>
          <a href="/" class="text-scifi-muted text-sm hover:text-scifi-text transition-colors">首页</a>
          <a href="/chat" class="text-scifi-muted text-sm hover:text-scifi-text transition-colors">AI对话</a>
          <a href="#" class="text-scifi-muted text-sm hover:text-scifi-text transition-colors">文章归档</a>
        </div>

        <!-- 技术栈区域 -->
        <div class="flex flex-col gap-3">
          <h3 class="font-mono text-sm text-scifi-secondary">// 技术栈</h3>
          <div class="flex flex-wrap gap-2">
            <span class="px-2 py-1 text-xs font-mono rounded bg-scifi-card border border-scifi-border text-scifi-muted">Astro</span>
            <span class="px-2 py-1 text-xs font-mono rounded bg-scifi-card border border-scifi-border text-scifi-muted">Tailwind</span>
            <span class="px-2 py-1 text-xs font-mono rounded bg-scifi-card border border-scifi-border text-scifi-muted">TypeScript</span>
            <span class="px-2 py-1 text-xs font-mono rounded bg-scifi-card border border-scifi-border text-scifi-muted">Claude AI</span>
          </div>
        </div>
      </div>

      <!-- 底部版权 -->
      <div class="mt-8 pt-6 border-t border-scifi-border/30 flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-scifi-muted text-xs font-mono">
          &copy; 2025 SciFi Blog. Built with <span class="text-scifi-accent">&lt;/&gt;</span> and imagination.
        </p>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-neon-green animate-pulse"></span>
          <span class="text-scifi-muted text-xs font-mono">系统状态: ONLINE</span>
        </div>
      </div>
    </div>

    <!-- 页脚底部装饰线 -->
    <div class="h-1 bg-gradient-to-r from-scifi-primary via-scifi-secondary to-scifi-accent opacity-50"></div>
  </footer>

  <!-- highlight.js -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      hljs.highlightAll();
    });
  </script>
</body>
</html>